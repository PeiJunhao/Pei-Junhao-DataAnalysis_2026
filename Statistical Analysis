# Spearman's correlation test

spearman_result<-cor.test(data$lipids1, data$lipids2, method="spearman")

print(spearman_result)

# data.frame for result
results <- data.frame(
  variable = character(),
  spearman_corr = numeric(),
  s_p_value = numeric(),
  stringsAsFactors = FALSE
)

# variables for analysis
target_vars <- c("lipids2", "lipids3", "lipids4")

# main 
for (var in target_vars) {
  test <- cor.test(data$lipids1, data[[var]], method="spearman")
  results <- rbind(results, data.frame(
    variable = var,
    spearman_corr = test$estimate,
    s_p_value =  test$p.value
  ))
}


# output result
print(results)

