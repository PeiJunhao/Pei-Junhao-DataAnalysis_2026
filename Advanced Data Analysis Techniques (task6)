# Load required libraries
library(vegan)      # for decostand (range standardization)
library(factoextra) # for PCA visualization (fviz_pca_biplot)
library(plotly)     # for interactive 3D plot
library(reshape2)   
library(ggplot2)    

# Read morphometry data (tab-separated file with header)
data <- read.table("data_morphometry.txt", header = TRUE, sep = "\t")

# Save the first column (likely group labels, e.g., sex or species)
p_names <- factor(data[, 1])

# Remove the first column from the data matrix (keep only numeric variables)
data <- data[, -1]

# Standardize columns to range [0,1] (min-max normalization)
data_std <- decostand(data, method = "range", MARGIN = 2)

# -------------------------------
# Correlation analysis (Spearman)
# -------------------------------

# Initialize matrices for correlation coefficients and p-values
n_vars <- ncol(data_std)
cor_matrix <- matrix(NA, nrow = n_vars, ncol = n_vars)
p_matrix <- matrix(NA, nrow = n_vars, ncol = n_vars)
rownames(cor_matrix) <- colnames(data_std)
colnames(cor_matrix) <- colnames(data_std)
rownames(p_matrix) <- colnames(data_std)
colnames(p_matrix) <- colnames(data_std)

# Loop over all variable pairs to compute Spearman correlation and p-value
for (i in 1:n_vars) {
  for (j in 1:n_vars) {
    test <- cor.test(data_std[, i], data_std[, j], method = "spearman")
    cor_matrix[i, j] <- test$estimate
    p_matrix[i, j] <- test$p.value
  }
}

# Set non-significant correlations (p > 0.05) to NA
sig_cor <- cor_matrix
sig_cor[p_matrix >= 0.05 | upper.tri(sig_cor)] <- NA
diag(sig_cor) <- NA

# Create table of significant correlations
sig_cor_table <- melt(sig_cor, na.rm = TRUE)
colnames(sig_cor_table) <- c("Trait1", "Trait2", "Spearman_Correlation")
cat("=== Table of Significant Spearman Correlations (p < 0.05) ===\n")
print(sig_cor_table)
cat("\n")

# -------------------------------
# Principal Component Analysis (PCA)
# -------------------------------

fit <- prcomp(data_std)
summary(fit)

# PCA biplot with groups (without ellipses)
fviz_pca_biplot(fit, habillage = p_names, repel = TRUE,
                title = "PCA Biplot (Group Colored, No Ellipses)")

# PCA biplot with colored points and 95% confidence ellipses
fviz_pca_biplot(fit, habillage = p_names, addEllipses = TRUE, ellipse.level = 0.95,
                ellipse.type = "confidence", repel = TRUE,
                title = "PCA Biplot (Group Colored + 95% Confidence Ellipses)")

# Extract PCA results
scores <- as.data.frame(fit$x[, 1:3])
colnames(scores) <- c("PC1", "PC2", "PC3")

loads <- as.data.frame(fit$rotation[, 1:3])
scale.loads <- 5

# -------------------------------
# Interactive 3D visualization
# -------------------------------

p <- plot_ly() %>% 
  add_trace(x = scores$PC1, y = scores$PC2, z = scores$PC3,
            type = "scatter3d", mode = "markers",
            color = p_names,
            marker = list(size = 5, opacity = 0.8)) %>%
  
  add_trace(data = loads, x = ~0, y = ~0, z = ~0,
            xend = ~PC1 * scale.loads, yend = ~PC2 * scale.loads, zend = ~PC3 * scale.loads,
            type = "scatter3d", mode = "lines",
            line = list(color = "red", width = 4), showlegend = FALSE) %>%
  
  add_text(data = loads, x = ~PC1 * scale.loads, y = ~PC2 * scale.loads, z = ~PC3 * scale.loads,
           text = rownames(loads), showlegend = FALSE) %>%
  
  layout(title = "3D Interactive PCA Biplot (PC1, PC2, PC3)",
         scene = list(xaxis = list(title = "PC1"),
                      yaxis = list(title = "PC2"),
                      zaxis = list(title = "PC3")))

print(p)

# PCA Interpretation
cat("=== PCA Results Interpretation ===\n")
cat("1. PC1 explains the highest proportion of variance, followed by PC2 and PC3.\n")
cat("2. Variables with the largest absolute loadings dominate the first principal components.\n")
cat("3. Group separation is determined by the overlap of 95% confidence ellipses.\n")
cat("4. Trait arrows in the same direction indicate positive correlations.\n")
